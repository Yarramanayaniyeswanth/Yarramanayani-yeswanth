# BLOCKBANK Environment Configuration (Example)
# Copy to .env for local development. Never commit real secrets.

# Server port (must be 3000 in AI Studio preview)
PORT="3000"

# Session signing secret (use a strong 32+ character random string in production)
SESSION_SECRET="replace-with-strong-random-session-secret"

# Application URL
APP_URL="MY_APP_URL"

# Optional Ethereum-compatible testnet integration (Sepolia / Holesky / Local Hardhat)
# When omitted, BLOCKBANK operates in clearly labeled Local Cryptographic Hash-Chain Simulation mode.
ETH_RPC_URL=""
AUDIT_CONTRACT_ADDRESS=""
ETH_SIGNER_PRIVATE_KEY=""

# Optional Admin Seed Credentials (used only on initial empty DB creation)
ADMIN_BOOTSTRAP_EMAIL="admin@blockbank.in"
ADMIN_BOOTSTRAP_PASSWORD=""
